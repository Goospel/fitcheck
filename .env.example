# 환경변수를 추가하면 이 파일도 같이 갱신하고 팀에 공유한다 (CLAUDE.md 3절)
# 복사해서 쓴다:  cp .env.example .env

# --- Supabase (BE-2가 프로젝트 생성 후 공유) ---
DATABASE_URL=postgresql+asyncpg://postgres:비밀번호@db.xxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# --- 인증 ---
JWT_SECRET=로컬은아무값이나
JWT_EXPIRE_HOURS=168

# --- 이미지 생성 (BE-3) ---
REPLICATE_API_TOKEN=

# --- 기타 ---
# ⚠️ 이 줄은 "프론트가 웹"이라는 가정 위에 있다 (Next.js 3000 · Vite 5173).
#    네이티브 앱이면 CORS 자체가 필요 없으므로 통째로 지운다 — docs/open-questions.md T6
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
