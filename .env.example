# 환경변수를 추가하면 이 파일도 같이 갱신하고 팀에 공유한다 (CLAUDE.md 3절)
# 복사해서 쓴다:  cp .env.example .env
#
# ⚠️ **이 파일에는 실제 값을 적지 않는다.** git 이 추적하므로 여기 적은 비밀번호는
#    그대로 GitHub 에 올라간다. 진짜 값은 `.env` 에만 넣는다 (.gitignore 에 있다).

# --- Supabase ---
# ⚠️ 반드시 **Session pooler** 문자열을 쓴다. Connect → Direct → Session pooler.
#    Direct connection (db.<ref>.supabase.co) 은 **IPv6 전용**이라 IPv4 망에서 안 붙고,
#    IPv4 애드온은 유료다. Transaction pooler(6543)는 prepared statement 를 못 써서
#    asyncpg 가 깨진다. 셋 중 Session pooler 만 그냥 된다.
# ⚠️ Supabase 가 주는 문자열은 `postgresql://` 로 시작한다 — **`postgresql+asyncpg://` 로 바꾼다.**
# ⚠️ 유저명은 `postgres` 가 아니라 `postgres.<프로젝트ref>` 다.
# ⚠️ 비밀번호에 @ # ? / : 가 있으면 percent-encoding 한다 (@ → %40).
DATABASE_URL=postgresql+asyncpg://postgres.프로젝트ref:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://프로젝트ref.supabase.co
# Storage(전신 사진) 붙일 때 채운다. 그전까진 비워도 앱이 뜬다
SUPABASE_SERVICE_KEY=

# --- 인증 ---
# ⚠️ 32바이트 이상으로. 짧으면 서명이 약해진다
#    uv run python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=로컬은아무값이나넣되32바이트는넘겨라
JWT_EXPIRE_HOURS=168

# --- 이미지 생성 (BE-3) ---
REPLICATE_API_TOKEN=

# --- 기타 ---
# ⚠️ 지금은 로컬 개발 주소뿐이다 (Next.js 3000 · Vite 5173).
#    프론트가 배포되면 그 도메인을 여기 추가해야 한다 — 안 그러면 브라우저가 요청을 막는다.
#    앱이면 CORS 자체가 무시되므로 이 줄은 있어도 해가 없다 — docs/open-questions.md T6
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
