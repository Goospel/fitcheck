# 환경변수를 추가하면 이 파일도 같이 갱신하고 팀에 공유한다 (CLAUDE.md 3절)
# 복사해서 쓴다:  cp .env.example .env

# --- Supabase (BE-2가 프로젝트 생성 후 공유) ---
DATABASE_URL=postgresql+asyncpg://postgres:비밀번호@db.xxxx.supabase.co:5432/postgres
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_KEY=

# --- 인증 ---
JWT_SECRET=로컬은아무값이나
JWT_EXPIRE_HOURS=168

# --- 이미지 생성 (BE-3) ---
REPLICATE_API_TOKEN=

# --- 기타 ---
# ⚠️ 지금은 로컬 개발 주소뿐이다 (Next.js 3000 · Vite 5173).
#    프론트가 배포되면 그 도메인을 여기 추가해야 한다 — 안 그러면 브라우저가 요청을 막는다.
#    앱이면 CORS 자체가 무시되므로 이 줄은 있어도 해가 없다 — docs/open-questions.md T6
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
